{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alencardoug/mvp_eng_dados_2/docs/pacote_de_metadados.schema.json",
  "title": "Pacote de metadados do mvp_eng_dados_2, formato 1",
  "description": "Contrato do pacote da D91. A especificação em prosa está em docs/pacote_de_metadados.md; vale o esquema do mesmo commit do pacote.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "provenance",
    "relations",
    "lineage",
    "crossings",
    "questions",
    "description_gaps",
    "tests",
    "view_audits",
    "environments",
    "checks",
    "open_items"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "relations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/relation_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/relation"
      }
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "crossings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    },
    "questions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^P[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/question"
      }
    },
    "description_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/description_gap"
      }
    },
    "tests": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(test|unit_test)\\.[a-z0-9_]+\\."
      },
      "additionalProperties": {
        "$ref": "#/$defs/test"
      }
    },
    "view_audits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^consumption\\.[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/view_audit"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_artifact"
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^tests/[a-z0-9_/]+\\.py::"
      },
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_item"
      }
    }
  },
  "$defs": {
    "relation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "column_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "text_or_null": {
      "description": "Texto ou null. A string vazia é recusada: a ausência é sempre null.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "timestamp_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/instante"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "meta": {
      "description": "O meta: do dbt, repassado como está. As chaves são as do manifest; não segue a regra de chave sempre presente.",
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_sha256",
        "inputs",
        "tree_dirty_at_generation",
        "environment",
        "dbt",
        "warehouse",
        "link_base"
      ],
      "properties": {
        "inputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputs": {
          "description": "Caminhos rastreados pelo Git cujo conteúdo entra no inputs_sha256, em ordem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dbt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dbt_version",
            "adapter_type",
            "manifest_generated_at",
            "manifest_invocation_id",
            "run_results_generated_at",
            "run_results_invocation_id"
          ],
          "properties": {
            "dbt_version": {
              "$ref": "#/$defs/nonempty"
            },
            "adapter_type": {
              "$ref": "#/$defs/nonempty"
            },
            "manifest_generated_at": {
              "$ref": "#/$defs/instante"
            },
            "manifest_invocation_id": {
              "$ref": "#/$defs/nonempty"
            },
            "run_results_generated_at": {
              "$ref": "#/$defs/instante"
            },
            "run_results_invocation_id": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "warehouse": {
          "description": "Qual execução construiu o armazém (L5). Na versão 1, sempre not_verified e null: o valor verified só entra com o desenho do Bloco 4, e muda o esquema.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "built_by_invocation_id"
          ],
          "properties": {
            "status": {
              "const": "not_verified"
            },
            "built_by_invocation_id": {
              "type": "null"
            }
          }
        },
        "link_base": {
          "description": "Diretório do repositório contra o qual se resolvem os links relativos dos textos.",
          "type": "string"
        },
        "tree_dirty_at_generation": {
          "description": "true se algum arquivo rastreado diferia do HEAD no momento da geração. O que prova que o pacote versionado bate com os insumos versionados é o inputs_sha256, conferido no commit fixado.",
          "type": "boolean"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dbt_target"
          ],
          "properties": {
            "dbt_target": {
              "description": "O target do profile do dbt com que os artefatos foram produzidos (hoje só local).",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "resource_type",
        "materialization",
        "description",
        "meta",
        "columns",
        "grain",
        "grants_select"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "source",
            "seed",
            "model",
            "snapshot"
          ]
        },
        "materialization": {
          "description": "null para source.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "$ref": "#/$defs/text_or_null"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        },
        "grain": {
          "description": "O grão declarado: o texto entre '**Grão:' e '**' no início da descrição da relação (convenção das fatos e dimensões). null quando a relação não declara.",
          "$ref": "#/$defs/text_or_null"
        },
        "grants_select": {
          "description": "Os papéis que podem ler a relação, em ordem: do config.grants.select do modelo, snapshot ou seed; do meta.grants.select na source (o que a macro aplicar_acesso_por_camada concede). Lista vazia sem concessão.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "data_type",
        "sensitivity",
        "meta"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text_or_null"
        },
        "data_type": {
          "$ref": "#/$defs/text_or_null"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "personal",
            null
          ]
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "lineage": {
      "description": "A saída de python -m mvp_ed1.models.lineage --json, formato 1, sem alteração.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "manifest_generated_at",
        "relations"
      ],
      "properties": {
        "format": {
          "const": 1
        },
        "manifest_generated_at": {
          "$ref": "#/$defs/timestamp_or_null"
        },
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/relation_id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "columns"
            ],
            "properties": {
              "columns": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "leaves",
                    "origins"
                  ],
                  "properties": {
                    "leaves": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/column_id"
                      }
                    },
                    "origins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "column",
                          "kind"
                        ],
                        "properties": {
                          "column": {
                            "$ref": "#/$defs/column_id"
                          },
                          "kind": {
                            "enum": [
                              "source",
                              "seed",
                              "generated"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "mechanism",
        "frequency",
        "note"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "facts",
        "measures",
        "dimensions",
        "view"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "additivity",
              "note"
            ],
            "properties": {
              "column": {
                "type": "string"
              },
              "additivity": {
                "enum": [
                  "additive",
                  "semi_additive",
                  "non_additive"
                ]
              },
              "note": {
                "$ref": "#/$defs/text_or_null"
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "view": {
          "$ref": "#/$defs/relation_id"
        }
      }
    },
    "description_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "column"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/relation_id"
        },
        "column": {
          "description": "null quando falta a descrição da própria relação.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "test",
        "relation",
        "column",
        "declared_in",
        "result"
      ],
      "properties": {
        "kind": {
          "enum": [
            "data_test",
            "unit_test"
          ]
        },
        "test": {
          "type": "string"
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/relation_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "$ref": "#/$defs/text_or_null"
        },
        "declared_in": {
          "type": "string"
        },
        "result": {
          "description": "null = sem resultado. Nunca se infere sucesso da declaração.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executed_at",
                "invocation_id",
                "same_invocation_as_manifest"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn",
                    "error",
                    "skipped"
                  ]
                },
                "executed_at": {
                  "$ref": "#/$defs/timestamp_or_null"
                },
                "invocation_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "same_invocation_as_manifest": {
                  "type": "boolean"
                }
              },
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "pass",
                      "fail",
                      "warn",
                      "error"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "executed_at": {
                    "$ref": "#/$defs/instante"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "view_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commit",
        "criteria",
        "reference",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_audited",
            "audited",
            "audit_pending_decision"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commit_or_null"
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "non_additivity",
              "time_dependent_balance",
              "truncated_population"
            ]
          }
        },
        "reference": {
          "description": "Caminho do teste versionado que calcula a referência independente.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "findings": {
          "description": "IDs dos achados (F1, F2, F14…) que a auditoria registrou para esta view.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_audited"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "null"
              },
              "criteria": {
                "maxItems": 0
              },
              "reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "audited"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "string"
              },
              "criteria": {
                "minItems": 3,
                "uniqueItems": true
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "audit_pending_decision"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "string"
              },
              "criteria": {
                "minItems": 1,
                "uniqueItems": true
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "environment_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repository",
        "path",
        "delivery",
        "commit",
        "frozen_at",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "title": {
          "type": "string"
        },
        "repository": {
          "enum": [
            "mvp_eng_dados_2",
            "mvp_eng_dados_1"
          ]
        },
        "path": {
          "type": "string"
        },
        "delivery": {
          "enum": [
            "read_by_commit",
            "in_package",
            "not_available"
          ]
        },
        "commit": {
          "description": "null = o commit fixado pelo consumidor neste repositório; preenchido quando o artefato vive em outro repositório.",
          "$ref": "#/$defs/commit_or_null"
        },
        "frozen_at": {
          "description": "Data em que o artefato deixou de mudar (infraestrutura destruída), ou null.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "note": {
          "$ref": "#/$defs/text_or_null"
        }
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "summary",
        "layer",
        "result"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^tests/[a-z0-9_/]+\\.py$"
        },
        "summary": {
          "description": "A primeira linha da docstring do módulo: o que ele guarda.",
          "$ref": "#/$defs/text_or_null"
        },
        "result": {
          "description": "null = sem resultado. Nunca se infere sucesso da existência do teste.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executed_at",
                "run_id"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "error",
                    "skipped"
                  ]
                },
                "executed_at": {
                  "$ref": "#/$defs/instante"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "layer": {
          "description": "A camada que o teste guarda. null = não declarado: hoje nenhum teste do pytest declara camada, e o pacote não a infere do nome.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "raw",
                "raw_legacy",
                "staging",
                "trusted",
                "quarantine",
                "snapshots",
                "analytics",
                "consumption",
                "governance"
              ]
            }
          ]
        }
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "state",
        "anchor",
        "objects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(D|V)[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending",
            "deferred"
          ]
        },
        "anchor": {
          "description": "O caminho do texto no repositório, com a âncora, no commit fixado.",
          "type": "string",
          "pattern": "^docs/[a-z0-9_/]+\\.md#[^\\s]+$"
        },
        "objects": {
          "description": "Os objetos que o item toca. null = não declarado (hoje, todos): o portal não infere.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relation_id"
              }
            }
          ]
        }
      }
    },
    "instante": {
      "description": "Instante ISO 8601 em UTC ou com fuso, ancorado nas duas pontas, com as faixas de mês, dia, hora, minuto e segundo. O calendário (31 de fevereiro) não cabe numa expressão regular: o gerador confere cada instante com datetime.fromisoformat, e o teste do exemplo também.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
