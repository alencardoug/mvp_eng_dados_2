{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alencardoug/mvp_eng_dados_2/docs/pacote_de_metadados.schema.json",
  "title": "Pacote de metadados do mvp_eng_dados_2, formato 1",
  "description": "Contrato do pacote da D91. A especificação em prosa está em docs/pacote_de_metadados.md; vale o esquema do mesmo commit do pacote.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "provenance",
    "relations",
    "lineage",
    "crossings",
    "questions",
    "metrics",
    "filters",
    "view_rules",
    "description_gaps",
    "tests",
    "view_audits",
    "environments",
    "checks",
    "open_items"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "relations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/relation_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/relation"
      }
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "crossings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    },
    "questions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^P[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/question"
      }
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "filters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/filter"
      }
    },
    "view_rules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^consumption\\.[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/view_rule"
      }
    },
    "description_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/description_gap"
      }
    },
    "tests": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(test|unit_test)\\.[a-z0-9_]+\\."
      },
      "additionalProperties": {
        "$ref": "#/$defs/test"
      }
    },
    "view_audits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^consumption\\.[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/view_audit"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_artifact"
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^tests/[a-z0-9_/]+\\.py::"
      },
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_item"
      }
    }
  },
  "$defs": {
    "relation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "column_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "text_or_null": {
      "description": "Texto ou null. A string vazia é recusada: a ausência é sempre null.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "timestamp_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/instante"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "meta": {
      "description": "O meta: do dbt, repassado como está. As chaves são as do manifest; não segue a regra de chave sempre presente.",
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_sha256",
        "inputs",
        "tree_dirty_at_generation",
        "environment",
        "dbt",
        "warehouse",
        "link_base"
      ],
      "properties": {
        "inputs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputs": {
          "description": "Caminhos rastreados pelo Git cujo conteúdo entra no inputs_sha256, em ordem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dbt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dbt_version",
            "adapter_type",
            "manifest_generated_at",
            "manifest_invocation_id",
            "run_results_generated_at",
            "run_results_invocation_id"
          ],
          "properties": {
            "dbt_version": {
              "$ref": "#/$defs/nonempty"
            },
            "adapter_type": {
              "$ref": "#/$defs/nonempty"
            },
            "manifest_generated_at": {
              "$ref": "#/$defs/instante"
            },
            "manifest_invocation_id": {
              "$ref": "#/$defs/nonempty"
            },
            "run_results_generated_at": {
              "$ref": "#/$defs/instante"
            },
            "run_results_invocation_id": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "warehouse": {
          "description": "A procedência do armazém no momento da geração (L5, ADR-0054), lida da view governance.warehouse_provenance: verified só quando a última execução registrada é um build integral, aprovado, de commit conhecido e limpo, com os insumos confirmados, sem nada aberto nem sobreposto, **e** é a execução que produziu o manifest deste pacote. Os campos novos de 15/11/2026 não mudam o formato (regra 3).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "built_by_invocation_id",
            "built_from_commit",
            "built_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "not_verified"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "no_connection",
                    "other_execution",
                    "no_execution",
                    "open_execution",
                    "abandoned_execution",
                    "failed_execution",
                    "partial_execution",
                    "unknown_commit",
                    "dirty_tree",
                    "inputs_not_confirmed",
                    "overlapping_execution"
                  ]
                }
              ]
            },
            "built_by_invocation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "built_from_commit": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              ]
            },
            "built_at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/instante"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "null"
                  },
                  "built_by_invocation_id": {
                    "type": "string"
                  },
                  "built_from_commit": {
                    "type": "string"
                  },
                  "built_at": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_verified"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "link_base": {
          "description": "Diretório do repositório contra o qual se resolvem os links relativos dos textos.",
          "type": "string"
        },
        "tree_dirty_at_generation": {
          "description": "true se algum arquivo rastreado diferia do HEAD no momento da geração. O que prova que o pacote versionado bate com os insumos versionados é o inputs_sha256, conferido no commit fixado.",
          "type": "boolean"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dbt_target"
          ],
          "properties": {
            "dbt_target": {
              "description": "O target do profile do dbt com que os artefatos foram produzidos (hoje só local).",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "resource_type",
        "materialization",
        "description",
        "meta",
        "columns",
        "grain",
        "grants_select"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "source",
            "seed",
            "model",
            "snapshot"
          ]
        },
        "materialization": {
          "description": "null para source.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "$ref": "#/$defs/text_or_null"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        },
        "grain": {
          "description": "O grão declarado: o texto entre '**Grão:' e '**' no início da descrição da relação (convenção das fatos e dimensões). null quando a relação não declara.",
          "$ref": "#/$defs/text_or_null"
        },
        "grants_select": {
          "description": "Os papéis que podem ler a relação, em ordem: do config.grants.select do modelo, snapshot ou seed; do meta.grants.select na source (o que a macro aplicar_acesso_por_camada concede). Lista vazia sem concessão.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "data_type",
        "sensitivity",
        "meta"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/text_or_null"
        },
        "data_type": {
          "$ref": "#/$defs/text_or_null"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "personal",
            null
          ]
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "lineage": {
      "description": "A saída de python -m mvp_ed1.models.lineage --json, formato 1, sem alteração.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "manifest_generated_at",
        "relations"
      ],
      "properties": {
        "format": {
          "const": 1
        },
        "manifest_generated_at": {
          "$ref": "#/$defs/timestamp_or_null"
        },
        "relations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/relation_id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "columns"
            ],
            "properties": {
              "columns": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "leaves",
                    "origins"
                  ],
                  "properties": {
                    "leaves": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/column_id"
                      }
                    },
                    "origins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "column",
                          "kind"
                        ],
                        "properties": {
                          "column": {
                            "$ref": "#/$defs/column_id"
                          },
                          "kind": {
                            "enum": [
                              "source",
                              "seed",
                              "generated"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "mechanism",
        "frequency",
        "note"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "facts",
        "measures",
        "dimensions",
        "view"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "additivity",
              "note"
            ],
            "properties": {
              "column": {
                "type": "string"
              },
              "additivity": {
                "enum": [
                  "additive",
                  "semi_additive",
                  "non_additive"
                ]
              },
              "note": {
                "$ref": "#/$defs/text_or_null"
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "view": {
          "$ref": "#/$defs/relation_id"
        }
      }
    },
    "description_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "column"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/relation_id"
        },
        "column": {
          "description": "null quando falta a descrição da própria relação.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "test",
        "relation",
        "column",
        "declared_in",
        "result"
      ],
      "properties": {
        "kind": {
          "enum": [
            "data_test",
            "unit_test"
          ]
        },
        "test": {
          "type": "string"
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/relation_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "$ref": "#/$defs/text_or_null"
        },
        "declared_in": {
          "type": "string"
        },
        "result": {
          "description": "null = sem resultado. Nunca se infere sucesso da declaração.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executed_at",
                "invocation_id",
                "same_invocation_as_manifest"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn",
                    "error",
                    "skipped"
                  ]
                },
                "executed_at": {
                  "$ref": "#/$defs/timestamp_or_null"
                },
                "invocation_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "same_invocation_as_manifest": {
                  "type": "boolean"
                }
              },
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "pass",
                      "fail",
                      "warn",
                      "error"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "executed_at": {
                    "$ref": "#/$defs/instante"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "view_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commit",
        "criteria",
        "reference",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_audited",
            "audited",
            "audit_pending_decision"
          ]
        },
        "commit": {
          "$ref": "#/$defs/commit_or_null"
        },
        "criteria": {
          "type": "array",
          "items": {
            "enum": [
              "non_additivity",
              "time_dependent_balance",
              "truncated_population"
            ]
          }
        },
        "reference": {
          "description": "Caminho do teste versionado que calcula a referência independente.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "findings": {
          "description": "IDs dos achados (F1, F2, F14…) que a auditoria registrou para esta view.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_audited"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "null"
              },
              "criteria": {
                "maxItems": 0
              },
              "reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "audited"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "string"
              },
              "criteria": {
                "minItems": 3,
                "uniqueItems": true
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "audit_pending_decision"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "string"
              },
              "criteria": {
                "minItems": 1,
                "uniqueItems": true
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "environment_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repository",
        "path",
        "delivery",
        "commit",
        "frozen_at",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "title": {
          "type": "string"
        },
        "repository": {
          "enum": [
            "mvp_eng_dados_2",
            "mvp_eng_dados_1"
          ]
        },
        "path": {
          "type": "string"
        },
        "delivery": {
          "enum": [
            "read_by_commit",
            "in_package",
            "not_available"
          ]
        },
        "commit": {
          "description": "null = o commit fixado pelo consumidor neste repositório; preenchido quando o artefato vive em outro repositório.",
          "$ref": "#/$defs/commit_or_null"
        },
        "frozen_at": {
          "description": "Data em que o artefato deixou de mudar (infraestrutura destruída), ou null.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "note": {
          "$ref": "#/$defs/text_or_null"
        }
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "summary",
        "layer",
        "result"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^tests/[a-z0-9_/]+\\.py$"
        },
        "summary": {
          "description": "A primeira linha da docstring do módulo: o que ele guarda.",
          "$ref": "#/$defs/text_or_null"
        },
        "result": {
          "description": "null = sem resultado. Nunca se infere sucesso da existência do teste.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executed_at",
                "run_id"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "error",
                    "skipped"
                  ]
                },
                "executed_at": {
                  "$ref": "#/$defs/instante"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "layer": {
          "description": "A camada que o teste guarda. null = não declarado: hoje nenhum teste do pytest declara camada, e o pacote não a infere do nome.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "raw",
                "raw_legacy",
                "staging",
                "trusted",
                "quarantine",
                "snapshots",
                "analytics",
                "consumption",
                "governance"
              ]
            }
          ]
        }
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "state",
        "anchor",
        "objects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(D|V)[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending",
            "deferred"
          ]
        },
        "anchor": {
          "description": "O caminho do texto no repositório, com a âncora, no commit fixado.",
          "type": "string",
          "pattern": "^docs/[a-z0-9_/]+\\.md#[^\\s]+$"
        },
        "objects": {
          "description": "Os objetos que o item toca. null = não declarado (hoje, todos): o portal não infere.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relation_id"
              }
            }
          ]
        }
      }
    },
    "instante": {
      "description": "Instante ISO 8601 em UTC ou com fuso, ancorado nas duas pontas, com as faixas de mês, dia, hora, minuto e segundo. O calendário (31 de fevereiro) não cabe numa expressão regular: o gerador confere cada instante com datetime.fromisoformat, e o teste do exemplo também.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    },
    "metric_source": {
      "description": "A fonte da medida como as expressões a leem: a relação de `analytics`, o apelido, a data que define o período (ligada a `dim_date`, apelido `d`) e as junções, na ordem declarada.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "alias",
        "date",
        "joins"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/relation_id"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "label"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "joins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "alias",
              "using",
              "match"
            ],
            "properties": {
              "relation": {
                "$ref": "#/$defs/relation_id"
              },
              "alias": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "using": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "match": {
                "anyOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": {
                  "using": {
                    "type": "array"
                  },
                  "match": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "using": {
                    "type": "null"
                  },
                  "match": {
                    "type": "array"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "metric": {
      "description": "Uma medida (`kind: measure`, um agregado sobre uma fonte) ou uma métrica (`ratio`, `difference`, sobre os nomes de outras medidas e métricas), como `metricas.yml` a declara. As expressões são SQL sobre os apelidos da fonte. Toda chave presente; `null` onde o tipo não a usa. O agregado leva o que ele exige: `sum`, `avg`, `max` e `median`, a `expression`; `count_distinct`, a `identity`; `count_where`, o `where`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "additivity",
        "note",
        "columns",
        "source",
        "aggregate",
        "expression",
        "identity",
        "where",
        "filters",
        "cast",
        "numerator",
        "denominator",
        "minuend",
        "subtrahend",
        "scale",
        "zero_denominator",
        "round"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measure",
            "ratio",
            "difference"
          ]
        },
        "additivity": {
          "enum": [
            "additive",
            "semi_additive",
            "non_additive"
          ]
        },
        "note": {
          "$ref": "#/$defs/text_or_null"
        },
        "columns": {
          "description": "As colunas das views montadas que publicam a medida ou a métrica, com a aditividade na view, que o grão pode mudar.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "additivity"
            ],
            "properties": {
              "column": {
                "$ref": "#/$defs/column_id"
              },
              "additivity": {
                "enum": [
                  "additive",
                  "semi_additive",
                  "non_additive"
                ]
              }
            }
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/metric_source"
            },
            {
              "type": "null"
            }
          ]
        },
        "aggregate": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "count",
                "count_distinct",
                "count_where",
                "avg",
                "max",
                "median"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "expression": {
          "$ref": "#/$defs/text_or_null"
        },
        "identity": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "where": {
          "$ref": "#/$defs/text_or_null"
        },
        "filters": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "cast": {
          "anyOf": [
            {
              "enum": [
                "numeric"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "numerator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minuend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "subtrahend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "zero_denominator": {
          "description": "Na razão, o que vale com o denominador zero: `\"null\"` (texto) = a métrica dá nulo. `null` = não se aplica.",
          "enum": [
            "null",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "measure"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "$ref": "#/$defs/metric_source"
              },
              "aggregate": {
                "type": "string"
              },
              "filters": {
                "type": "array"
              },
              "numerator": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              },
              "minuend": {
                "type": "null"
              },
              "subtrahend": {
                "type": "null"
              },
              "scale": {
                "type": "null"
              },
              "zero_denominator": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ratio"
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "type": "string"
              },
              "denominator": {
                "type": "string"
              },
              "zero_denominator": {
                "const": "null"
              },
              "source": {
                "type": "null"
              },
              "aggregate": {
                "type": "null"
              },
              "expression": {
                "type": "null"
              },
              "identity": {
                "type": "null"
              },
              "where": {
                "type": "null"
              },
              "filters": {
                "type": "null"
              },
              "cast": {
                "type": "null"
              },
              "minuend": {
                "type": "null"
              },
              "subtrahend": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "difference"
              }
            }
          },
          "then": {
            "properties": {
              "minuend": {
                "type": "string"
              },
              "subtrahend": {
                "type": "string"
              },
              "source": {
                "type": "null"
              },
              "aggregate": {
                "type": "null"
              },
              "expression": {
                "type": "null"
              },
              "identity": {
                "type": "null"
              },
              "where": {
                "type": "null"
              },
              "filters": {
                "type": "null"
              },
              "cast": {
                "type": "null"
              },
              "numerator": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              },
              "scale": {
                "type": "null"
              },
              "zero_denominator": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "aggregate": {
                "enum": [
                  "sum",
                  "avg",
                  "max",
                  "median"
                ]
              }
            },
            "required": [
              "aggregate"
            ]
          },
          "then": {
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "aggregate": {
                "const": "count_distinct"
              }
            },
            "required": [
              "aggregate"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "aggregate": {
                "const": "count_where"
              }
            },
            "required": [
              "aggregate"
            ]
          },
          "then": {
            "properties": {
              "where": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "filter": {
      "description": "Um filtro de fonte: o predicado SQL sobre os apelidos da fonte, o rótulo e o conceito do glossário de que ele sai.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "predicate",
        "label",
        "concept"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/relation_id"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "description": "Link para o documento do conceito, relativo a `provenance.link_base`.",
          "type": "string",
          "pattern": "^glossario_de_negocio/[a-z0-9_]+\\.md$"
        }
      }
    },
    "view_rule": {
      "description": "A montagem de uma view de `consumption`, como `metricas.yml` a declara (Q33): o grão, as fontes com o grão, as medidas, os filtros e as junções que a montagem usa, a combinação entre as fontes e o papel de cada coluna. Na view conferida por referência, `grain` e `combine` são `null`, `sources` é vazio e `reference` diz o teste, a consulta e o motivo.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "facts",
        "dimensions",
        "grain",
        "sources",
        "combine",
        "columns",
        "reference"
      ],
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_id"
          }
        },
        "grain": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "alias",
              "date",
              "grain",
              "measures",
              "filters",
              "joins"
            ],
            "properties": {
              "relation": {
                "$ref": "#/$defs/relation_id"
              },
              "alias": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "date": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "column",
                  "label"
                ],
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "grain": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "measures": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "joins": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/relation_id"
                }
              }
            }
          }
        },
        "combine": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "keys",
                "missing"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "full",
                    "left"
                  ]
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "missing": {
                  "description": "O valor do lado ausente; `null` = fica nulo.",
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "name",
              "additivity",
              "note"
            ],
            "properties": {
              "role": {
                "enum": [
                  "grain",
                  "identity",
                  "measure",
                  "metric",
                  "reference"
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "additivity": {
                "anyOf": [
                  {
                    "enum": [
                      "additive",
                      "semi_additive",
                      "non_additive"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "$ref": "#/$defs/text_or_null"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": [
                        "measure",
                        "metric"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "additivity": {
                      "enum": [
                        "additive",
                        "semi_additive",
                        "non_additive"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "reference"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "name": {
                      "type": "null"
                    },
                    "additivity": {
                      "enum": [
                        "additive",
                        "semi_additive",
                        "non_additive"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": [
                        "grain",
                        "identity"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "name": {
                      "type": "null"
                    },
                    "additivity": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "test",
                "query",
                "reason"
              ],
              "properties": {
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "reference": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "grain": {
            "type": "object"
          },
          "sources": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "grain": {
            "type": "null"
          },
          "combine": {
            "type": "null"
          },
          "sources": {
            "maxItems": 0
          }
        }
      }
    }
  }
}
